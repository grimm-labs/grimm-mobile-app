NOTIFICATION_API_URL=https://notification-service-dev.usegrimm.app

## Firebase Android push (google-services.json)
# Do NOT commit the real files. Place one JSON per environment:
#   credentials/firebase/google-services.development.json  → com.grimm.labs.app.development
#   credentials/firebase/google-services.staging.json      → com.grimm.labs.app.staging
#   credentials/firebase/google-services.production.json   → com.grimm.labs.app
# Copy credentials/firebase/google-services.example.json as a starting point.
# Download each file from Firebase Console (Project settings → Your apps → Android).
#
# CI: store base64-encoded JSON in GitHub secrets:
#   GOOGLE_SERVICES_JSON_DEVELOPMENT
#   GOOGLE_SERVICES_JSON_STAGING
#   GOOGLE_SERVICES_JSON_PRODUCTION
# Encode locally: base64 -i credentials/firebase/google-services.development.json | pbcopy
#
# FCM V1 Service Account (for sending push via Expo) stays in Expo Credentials — not in this repo.

